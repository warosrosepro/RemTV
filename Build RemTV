name: Build RemTV

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      # Finds the folder with build.sh, wherever it lies in the repository
      - name: Find the project folder
        id: find
        run: |
          f=$(find . -maxdepth 3 -name build.sh -not -path './.git/*' | head -n 1)
          if [ -z "$f" ]; then echo "build.sh not found"; exit 1; fi
          echo "dir=$(dirname "$f")" >> "$GITHUB_OUTPUT"

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Android SDK parts
        run: |
          "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" "build-tools;34.0.0" "platforms;android-34" || true

      # Optional: your own permanent signing key (secrets KEYSTORE_BASE64, KEYSTORE_PASSWORD, KEY_ALIAS).
      # Without it a temporary key is used, and every new build must be installed over the old one by uninstalling first.
      - name: Signing key
        env:
          KEYSTORE_BASE64: ${{ secrets.KEYSTORE_BASE64 }}
        run: |
          if [ -n "$KEYSTORE_BASE64" ]; then
            echo "$KEYSTORE_BASE64" | base64 -d > "$RUNNER_TEMP/release.keystore"
            echo "RELEASE_KEYSTORE=$RUNNER_TEMP/release.keystore" >> "$GITHUB_ENV"
          fi

      - name: Build RemTV.apk
        working-directory: ${{ steps.find.outputs.dir }}
        env:
          RELEASE_KEYSTORE_PASS: ${{ secrets.KEYSTORE_PASSWORD }}
          RELEASE_KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
          VERSION_CODE: ${{ github.run_number }}
          VERSION_NAME: 1.0.${{ github.run_number }}
        run: bash build.sh

      - name: Save the APK as a build artifact
        uses: actions/upload-artifact@v4
        with:
          name: RemTV
          path: ${{ steps.find.outputs.dir }}/build/RemTV.apk

      # A release page with the file RemTV.apk, so it can be downloaded with one tap
      - name: Publish a release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: v1.0.${{ github.run_number }}
          name: RemTV 1.0.${{ github.run_number }}
          files: ${{ steps.find.outputs.dir }}/build/RemTV.apk
